<header>
  <div class="header-inner">
    {# The mark carries no information the wordmark beside it does not already
       give, so alt="" keeps a screen reader from announcing the link twice.

       The webp is 72px square — twice the rendered size, so it stays sharp on
       a 2x display without paying for the full-resolution source. logo.png is
       the fallback for the browsers that cannot decode webp. #}
    <a href="/" class="site-logo">
      <picture>
        <source type="image/webp" srcset="{{ '/assets/img/logo-72.webp' | asset }}">
        <img
          src="{{ '/assets/img/logo.png' | asset }}"
          alt=""
          width="36"
          height="36"
        >
      </picture>
      mxwolf
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        <li>
          <a href="/" class="nav-link"{% if page.url == "/" %} aria-current="page"{% endif %}
            >Home</a
          >
        </li>

        {# The submenu opens on :hover and :focus-within, so it needs no
           JavaScript. "About" stays a real link for the cases CSS cannot
           cover — touch taps and no-pointer devices — where /about/ lists
           the same two destinations as the dropdown. #}
        <li class="has-submenu">
          <a
            href="/about/"
            class="nav-link submenu-trigger"
            {% if page.url == "/about/" %}aria-current="page"{% endif %}
            >About</a
          >
          <ul class="submenu">
            <li>
              <a
                href="/about/me/"
                class="submenu-link"
                {% if page.url == "/about/me/" %}aria-current="page"{% endif %}
                >Me</a
              >
            </li>
            <li>
              <a
                href="/about/this-page/"
                class="submenu-link"
                {% if page.url == "/about/this-page/" %}aria-current="page"{% endif %}
                >This page</a
              >
            </li>
          </ul>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      {# Hidden until main.js takes over: without JavaScript the theme follows
         prefers-color-scheme and there is nothing for this button to do, so
         showing a dead control would be worse than showing none. #}
      <button type="button" class="theme-toggle" id="theme-toggle" hidden aria-pressed="false">
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.5" />
          <path
            d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M19.4 4.6l-2.1 2.1M6.7 17.3l-2.1 2.1"
          />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20.5 14.5A9 9 0 1 1 9.5 3.5a7.5 7.5 0 0 0 11 11Z" />
        </svg>
        <span class="visually-hidden">Dark theme</span>
      </button>

      <a
        class="social-link"
        href="https://www.linkedin.com/in/adrianpadillavega/"
        rel="me noopener"
        target="_blank"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4v11H3v-11Zm6.5 0h3.84v1.5h.05a4.2 4.2 0 0 1 3.78-2.08c4.04 0 4.79 2.66 4.79 6.12v5.46h-4v-4.84c0-1.5-.03-3.43-2.09-3.43-2.09 0-2.41 1.63-2.41 3.32v4.95h-3.96v-11Z"
          />
        </svg>
        <span class="visually-hidden">LinkedIn (opens in a new tab)</span>
      </a>
    </div>
  </div>
</header>
