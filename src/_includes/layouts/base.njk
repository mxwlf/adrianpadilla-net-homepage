<!DOCTYPE html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
      {% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}
    </title>
    <meta name="description" content="{{ description or site.description }}">

    {# Canonical (avoid duplicate URL variants) #}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    {# Open Graph (rich link previews) #}
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:image" content="{{ site.url }}{{ site.socialImage | asset }}">

    {# Declaring an icon stops the browser probing /favicon.ico, whose 404
       showed up as a console error and failed Lighthouse's errors-in-console
       audit. Placeholder artwork — replace with real branding. #}
    <link rel="icon" href="{{ '/assets/img/favicon.svg' | asset }}" type="image/svg+xml">

    {# Poppins is self-hosted: the CSP allows no third-party font or style
       origins, so a Google Fonts <link> would simply be blocked. Only the two weights used
       above the fold are preloaded; 500/600 (nav) arrive with font-display:
       swap. Filenames carry the upstream font version, which is what makes
       the immutable Cache-Control on /static/fonts/* in
       staticwebapp.config.json safe. #}
    <link
      rel="preload"
      href="/static/fonts/poppins-v24-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    >
    <link
      rel="preload"
      href="/static/fonts/poppins-v24-latin-300.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    >

    {# Minimal CSS, no frameworks. The `asset` filter resolves the
       content-hashed filename so /assets/* can be cached immutably. #}
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | asset }}">

    {# Deferred, so not render-blocking, but discovered here rather than at the
       end of <body>: deferred scripts run once parsing finishes and before
       DOMContentLoaded, which is early enough to apply a stored theme choice
       without a flash of the other one. #}
    <script src="{{ '/assets/js/main.js' | asset }}" defer></script>

    {# Google tag (gtag.js). Both tags are async/deferred, so neither blocks
       rendering; the bootstrap Google documents inline lives in analytics.js
       because inline scripts are forbidden here and blocked by the CSP.

       Both tags are emitted in every build, including local ones. analytics.js
       decides at runtime whether to measure, from the canonical URL passed
       below: that keeps one artifact for dev, CI and production while leaving
       the development loop out of the property. #}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaMeasurementId }}"></script>
    <script
      src="{{ '/assets/js/analytics.js' | asset }}"
      data-measurement-id="{{ site.gaMeasurementId }}"
      data-site-url="{{ site.url }}"
      defer
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    {% include "partials/header.njk" %}

    <main id="content">
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
  </body>
</html>
