{
  "name": "static-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "fmt": "prettier . --write",
    "lint": "prettier . --check && eslint . && stylelint \"src/assets/css/**/*.css\"",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "test:unit": "node --test",
    "test:e2e": "playwright test --reporter=line",
    "test:a11y": "playwright test -c playwright.a11y.config.ts --reporter=line",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.0.0",
    "html-validate": "^9.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^37.0.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.3",
    "qs": "^6.17.0",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  }
}
