{
  "name": "adrianpadilla-net-homepage",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "fmt": "prettier . --write",
    "lint": "prettier . --check && eslint . && stylelint \"src/assets/css/**/*.css\"",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "test:unit": "node --test",
    "test:e2e": "playwright test --reporter=line",
    "test:a11y": "playwright test -c playwright.a11y.config.ts --reporter=line",
    "lighthouse": "lhci autorun",
    "report:html": "html-validate \"dist/**/*.html\" --formatter json",
    "report:e2e": "playwright test --reporter=json",
    "report:a11y": "playwright test -c playwright.a11y.config.ts --reporter=json",
    "report:lighthouse": "lhci collect && lhci upload --target=filesystem --outputDir=reports/lighthouse",
    "sbom": "cyclonedx-npm --output-format JSON --output-file sbom/bom.cdx.json"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@axe-core/playwright": "^4.14.0",
    "@azure/static-web-apps-cli": "2.1.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "clean-css": "^5.3.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "html-validate": "^11.19.0",
    "prettier": "^3.9.10",
    "serve": "14.2.7",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.3",
    "compression": "^1.8.2",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "qs": "^6.17.0",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "zod": "^4.6.7",
    "adm-zip": "^0.6.1",
    "deepmerge": "4.1.2"
  }
}
