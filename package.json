{
  "name": "adrianpadilla-net-homepage",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "fmt": "prettier . --write",
    "lint": "prettier . --check && eslint . && stylelint \"src/assets/css/**/*.css\"",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "test:unit": "node --test",
    "test:e2e": "playwright test --reporter=line",
    "test:a11y": "playwright test -c playwright.a11y.config.ts --reporter=line",
    "lighthouse": "lhci autorun",
    "report:html": "html-validate \"dist/**/*.html\" --formatter json",
    "report:e2e": "playwright test --reporter=json",
    "report:a11y": "playwright test -c playwright.a11y.config.ts --reporter=json",
    "report:lighthouse": "lhci autorun --upload.target=filesystem --upload.outputDir=reports/lighthouse",
    "sbom": "cyclonedx-npm --output-format JSON --output-file sbom/bom.cdx.json"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@axe-core/playwright": "^4.14.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "html-validate": "^11.18.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.3",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "qs": "^6.17.0",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  }
}
